{
  "name": "earth-directory",
  "version": "2.0.0",
  "description": "A shared source of truth to build a better future.",
  "license": "CC0 1.0 Universal",
  "keywords": [
    "dictionary",
    "words",
    "terms",
    "glossary"
  ],
  "private": true,
  "author": "Made For Earth",
  "scripts": {
    "dev": "next",
    "build": "npx prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "db:reset": "dotenv -e .env.local -e .env -- prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "studio": "dotenv -e .env.local -e .env -- prisma studio",
    "classify-terms": "dotenv -e .env.local -e .env -- ts-node scripts/classify-terms-with-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "@next-auth/prisma-adapter": "1.0.5",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@vercel/og": "^0.0.22",
    "lucide-react": "^0.575.0",
    "next": "16.2.0-canary.51",
    "next-auth": "^4.24.0",
    "next-videos": "^1.4.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "8.0.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/next-auth": "3.15.0",
    "@types/node": "18.11.18",
    "@types/react": "18.0.26",
    "autoprefixer": "^10.4.24",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "10.9.1",
    "typescript": "4.9.4"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
