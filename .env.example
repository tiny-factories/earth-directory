# Prisma – use this for local Docker Postgres (see README)
DATABASE_URL="postgresql://earth:earth@localhost:5432/earth_directory"
SECRET=

# When deploying to production, set the `NEXTAUTH_URL` environment variable to the canonical URL of your site.
NEXTAUTH_URL='http://localhost:3000'

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

#LogSnag
LOGSNAG=

#Umami
UMAMI='DEVELOPMENT'

# Claude (for term-type classification agent)
ANTHROPIC_API_KEY=
# Optional: override model (default claude-opus-5), e.g. CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Cron (weekly term classification). Set in production; Vercel sends Bearer CRON_SECRET.
CRON_SECRET=
# Gemini / Nano Banana (term illustration generation)
GEMINI_API_KEY=
# Optional: GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
